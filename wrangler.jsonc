{
  "name": "sparrow-site",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/mcp", "/mcp/", "/.well-known/openai-apps-challenge"]
  },
  "routes": [
    { "pattern": "sparrowmahjong.app", "custom_domain": true },
    { "pattern": "www.sparrowmahjong.app", "custom_domain": true }
  ]
}
