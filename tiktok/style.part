<!doctype html><html><head><meta charset="utf-8"><style>
@font-face{font-family:YS;src:url(youngserif-400.woff2)}
@font-face{font-family:FT;src:url(figtree-400.woff2);font-weight:400}
@font-face{font-family:FT;src:url(figtree-600.woff2);font-weight:600}
@font-face{font-family:FT;src:url(figtree-800.woff2);font-weight:800}
*{margin:0;box-sizing:border-box}
body{background:#000}
.s{width:1080px;height:1920px;position:relative;overflow:hidden;background:#FBF6EA;color:#1E1A36;font-family:FT;padding:520px 110px 0 100px}
.pink{background:#CF3A6E;color:#FBF6EA}
.n{font-family:YS;font-size:64px;color:#CF3A6E;margin-bottom:28px}
h1{font-family:YS;font-weight:400;font-size:112px;line-height:1.04;letter-spacing:-1px}
p{font-size:50px;line-height:1.35;margin-top:44px;color:#4A4460;max-width:860px}
.pink p{color:#FBE3EC}
.row{display:flex;gap:26px;margin-top:90px;align-items:center}
.t{width:150px;height:200px;border-radius:22px;background:#fff;box-shadow:0 12px 0 #E6D9B8,0 14px 30px rgba(30,26,54,.15);display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:YS;font-size:84px}
.t small{font-family:FT;font-weight:800;font-size:22px;letter-spacing:2px;margin-top:4px}
.j{color:#CF3A6E}.d{color:#2B58C9}.b{color:#23845A}.c{color:#C9343A}
.x{font-size:90px;font-weight:800;color:#C9343A;margin-left:10px}
.ok{font-size:80px;font-weight:800;color:#23845A;margin-left:10px}
.lab{font-size:34px;font-weight:600;color:#8A8399;margin-top:70px;letter-spacing:1px}
.arr{display:flex;gap:22px;margin-top:100px}
.arr div{background:#1E1A36;color:#FBF6EA;border-radius:999px;padding:30px 44px;font-size:48px;font-weight:800}
.bird{position:absolute;right:110px;top:150px;width:130px;border-radius:30px}
.phone{position:absolute;left:50%;transform:translateX(-50%);top:760px;width:720px;border-radius:44px;border:none;box-shadow:0 30px 60px rgba(0,0,0,.25)}
.cards{display:flex;gap:20px;margin-top:90px}
.cd{width:250px;height:150px;border-radius:18px;background:#fff;border:3px solid #E2DCEA;display:flex;align-items:center;justify-content:center;font-size:40px;font-weight:800}
</style></head><body>
